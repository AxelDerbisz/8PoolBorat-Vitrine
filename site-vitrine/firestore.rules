rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public read access for website content
    // Write access restricted to authenticated admins only
    match /news/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated(); // Authenticated users (admins) can write
    }

    match /teams/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated(); // Authenticated users (admins) can write
    }

    match /clubInfo/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated(); // Authenticated users (admins) can write
    }

    match /sponsors/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated(); // Authenticated users (admins) can write
    }

    match /contactMessages/{document=**} {
      allow read: if isAuthenticated(); // Only authenticated admins can read
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'timestamp', 'status', 'read'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
                    && request.resource.data.subject is string
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 10
                    && request.resource.data.status == 'new'
                    && request.resource.data.read == false;
      allow update, delete: if isAuthenticated(); // Authenticated admins can update/delete
    }

    // User profiles - users can read/write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      // Admins can read all user profiles
      allow read: if isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Bookings - reservations system
    match /bookings/{bookingId} {
      // All authenticated users can read all bookings (to see calendar)
      allow read: if isAuthenticated();
      // Users can create their own bookings
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      // Users can cancel their own pending or confirmed bookings
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && (resource.data.status == 'pending' || resource.data.status == 'confirmed')
                    && request.resource.data.status == 'cancelled';
      // Admins can update any booking (validate/refuse)
      allow update: if isAuthenticated()
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // Admins can delete any booking
      allow delete: if isAuthenticated()
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Incidents - problem reports
    match /incidents/{incidentId} {
      // Users can read their own incidents
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Users can create incidents
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Admins can read and update all incidents
      allow read, update, delete: if isAuthenticated()
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Settings - admin only
    match /settings/{document=**} {
      allow read, write: if isAuthenticated()
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Admin can update user roles
    match /users/{userId} {
      allow update: if isAuthenticated()
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
