rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public read access for website content
    // Write access restricted to authenticated admins only
    match /news/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated(); // Authenticated users (admins) can write
    }

    match /teams/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated(); // Authenticated users (admins) can write
    }

    match /clubInfo/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated(); // Authenticated users (admins) can write
    }

    match /sponsors/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated(); // Authenticated users (admins) can write
    }

    match /contactMessages/{document=**} {
      allow read: if isAuthenticated(); // Only authenticated admins can read
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'timestamp', 'status', 'read'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
                    && request.resource.data.subject is string
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 10
                    && request.resource.data.status == 'new'
                    && request.resource.data.read == false;
      allow update, delete: if isAuthenticated(); // Authenticated admins can update/delete
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
