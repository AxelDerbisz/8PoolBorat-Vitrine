rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated()
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Public read access for website content
    // Write access restricted to admins only
    match /news/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teams/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clubInfo/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sponsors/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contactMessages/{document=**} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'timestamp', 'status', 'read'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
                    && request.resource.data.subject is string
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 10
                    && request.resource.data.status == 'new'
                    && request.resource.data.read == false;
      allow update, delete: if isAdmin();
    }

    // User profiles - users can read/write their own profile (except role)
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Admins can read all profiles
      allow read: if isAdmin();
      // Users can create their own profile
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'member';
      // Users can update their own profile BUT cannot change their role
      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
      // Admins can update any user (including role changes)
      allow update: if isAdmin();
    }

    // Bookings - reservations system
    match /bookings/{bookingId} {
      // All authenticated users can read all bookings (needed for calendar view)
      allow read: if isAuthenticated();
      // Users can create their own bookings with pending status
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      // Users can cancel their own pending or confirmed bookings
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && (resource.data.status == 'pending' || resource.data.status == 'confirmed')
                    && request.resource.data.status == 'cancelled'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      // Admins can update bookings (validate/refuse) - only status and adminComment
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'adminComment', 'updatedAt']);
      // Admins can delete any booking
      allow delete: if isAdmin();
    }

    // Incidents - problem reports
    match /incidents/{incidentId} {
      // Users can read their own incidents
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Admins can read all incidents
      allow read: if isAdmin();
      // Users can create incidents for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Admins can update and delete incidents
      allow update, delete: if isAdmin();
    }

    // Settings - admin only (contains access codes)
    match /settings/{document=**} {
      allow read, write: if isAdmin();
    }

    // Notifications - users can only read/update their OWN notifications
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Users can mark their own notifications as read (only 'read' field)
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      // Cloud Functions create notifications (no client-side create)
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
